<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes" />
    <title>🎟️ QUINIENTAZO</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #0b0b1a 0%, #1a1a3e 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding: 20px 10px 40px;
            color: #fff;
        }
        .app {
            max-width: 1200px;
            width: 100%;
            background: rgba(255, 255, 255, 0.06);
            backdrop-filter: blur(12px);
            border-radius: 40px;
            padding: 25px 20px 35px;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .admin-toggle {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 12px;
        }
        .admin-toggle button {
            background: rgba(255, 215, 0, 0.15);
            border: 1px solid rgba(255, 215, 0, 0.3);
            color: #ffd966;
            padding: 8px 20px;
            border-radius: 40px;
            font-weight: 600;
            font-size: .9rem;
            cursor: pointer;
            transition: .2s;
        }
        .admin-toggle button:hover {
            background: rgba(255, 215, 0, 0.25);
            border-color: #ffd966;
            transform: scale(1.02);
        }
        .admin-panel {
            background: rgba(0, 0, 0, 0.55);
            backdrop-filter: blur(8px);
            border-radius: 28px;
            padding: 20px 22px 28px;
            margin-bottom: 25px;
            border: 1px solid rgba(255, 215, 0, 0.15);
            display: none;
        }
        .admin-panel.open {
            display: block;
        }
        .admin-panel h2 {
            font-size: 1.3rem;
            font-weight: 700;
            color: #ffd966;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .admin-panel h2::before {
            content: "🔑";
            font-size: 1.4rem;
        }
        .admin-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px 20px;
            margin-bottom: 22px;
        }
        .admin-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .admin-group label {
            font-size: .8rem;
            font-weight: 600;
            text-transform: uppercase;
            color: #b0b0d0;
        }
        .admin-group input,
        .admin-group textarea {
            background: rgba(255, 255, 255, 0.07);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 12px 16px;
            color: #fff;
            font-size: .95rem;
            transition: .2s;
            font-family: inherit;
            width: 100%;
        }
        .admin-group input:focus,
        .admin-group textarea:focus {
            outline: none;
            border-color: #ffd966;
            background: rgba(255, 255, 255, 0.10);
            box-shadow: 0 0 0 3px rgba(255, 215, 0, 0.15);
        }
        .admin-group textarea {
            resize: vertical;
            min-height: 70px;
        }
        .admin-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 6px;
        }
        .btn {
            border: none;
            border-radius: 40px;
            padding: 12px 28px;
            font-weight: 700;
            font-size: .95rem;
            cursor: pointer;
            transition: .2s;
            background: rgba(255, 255, 255, 0.06);
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.08);
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .btn-primary {
            background: linear-gradient(135deg, #f7b731, #f5a623);
            color: #0b0b1a;
            border: none;
            font-weight: 800;
            box-shadow: 0 8px 20px rgba(245, 166, 35, 0.25);
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(245, 166, 35, 0.35);
        }
        .btn-danger {
            background: rgba(255, 70, 70, 0.15);
            border: 1px solid rgba(255, 70, 70, 0.25);
            color: #ff6b6b;
        }
        .btn-danger:hover {
            background: rgba(255, 70, 70, 0.25);
        }
        .btn-borrar {
            background: rgba(255, 0, 0, 0.3);
            border: 1px solid rgba(255, 0, 0, 0.5);
            color: #ff4444;
        }
        .btn-borrar:hover {
            background: rgba(255, 0, 0, 0.5);
        }
        .header-info {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            gap: 10px;
        }
        .header-info .lottery-badge {
            background: rgba(255, 215, 0, 0.10);
            border: 1px solid rgba(255, 215, 0, 0.15);
            border-radius: 40px;
            padding: 6px 18px;
            font-size: .8rem;
            font-weight: 600;
            color: #ffd966;
        }
        .header-info .prize-name {
            font-size: 1.6rem;
            font-weight: 800;
            background: linear-gradient(135deg, #fff, #ffd966);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .header-info .prize-value {
            font-size: 1.2rem;
            font-weight: 700;
            color: #a0f0c0;
        }
        .numbers-section {
            margin-top: 28px;
        }
        .numbers-section h3 {
            font-size: 1.1rem;
            font-weight: 600;
            color: #c0c0e0;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .numbers-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(58px, 1fr));
            gap: 12px;
        }
        .number-item {
            aspect-ratio: 1/1;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1.1rem;
            cursor: pointer;
            transition: .15s;
            border: 1px solid rgba(255, 255, 255, 0.06);
            user-select: none;
            color: #ddd;
        }
        .number-item:hover {
            background: rgba(255, 215, 0, 0.10);
            transform: scale(1.04);
            border-color: rgba(255, 215, 0, 0.2);
        }
        .number-item.sold {
            background: rgba(255, 70, 70, 0.15);
            border-color: rgba(255, 70, 70, 0.2);
            color: #ff6b6b;
            text-decoration: line-through;
            cursor: not-allowed;
            opacity: .5;
        }
        .number-item.selected {
            background: rgba(255, 215, 0, 0.20);
            border-color: #ffd966;
            color: #ffd966;
            box-shadow: 0 0 20px rgba(255, 215, 0, 0.10);
        }
        .whatsapp-area {
            margin-top: 28px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            background: rgba(0, 0, 0, 0.25);
            border-radius: 30px;
            padding: 16px 22px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }
        .whatsapp-area .selected-info {
            font-size: .95rem;
            color: #c0c0e0;
        }
        .whatsapp-area .selected-info strong {
            color: #ffd966;
        }
        .btn-whatsapp {
            background: #25d366;
            border: none;
            border-radius: 40px;
            padding: 14px 32px;
            font-weight: 700;
            font-size: 1rem;
            color: #fff;
            cursor: pointer;
            transition: .2s;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 8px 24px rgba(37, 211, 102, 0.25);
        }
        .btn-whatsapp:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(37, 211, 102, 0.35);
        }
        .btn-whatsapp:disabled {
            opacity: .4;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }
        .toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(12px);
            padding: 14px 28px;
            border-radius: 60px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            color: #fff;
            font-weight: 500;
            font-size: .95rem;
            opacity: 0;
            transition: all .4s cubic-bezier(.22, 1, .36, 1);
            z-index: 999;
            pointer-events: none;
            text-align: center;
            max-width: 90%;
        }
        .toast.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }
        .pantalla-principal {
            display: flex;
            flex-direction: column;
            gap: 16px;
            padding: 10px 0;
        }
        .seccion-logo {
